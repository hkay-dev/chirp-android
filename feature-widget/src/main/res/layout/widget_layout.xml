<?xml version="1.0" encoding="utf-8"?>
<!--
  Theming (platform audit): the layout used hardcoded white-on-dark hex colors, ignoring
  dynamic color and light/dark. Theme.DeviceDefault.DayNight + ?android:attr colors is the
  documented Android 12+ widget dynamic-color pattern, so the widget now follows the
  system palette (Material You / One UI color theming) and flips with dark mode.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:background="@drawable/widget_background">

    <!-- App name -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_title"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Record/Stop button -->
    <ImageView
        android:id="@+id/widget_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_widget_record"
        android:contentDescription="@string/widget_desc_start_recording"
        android:scaleType="fitCenter"
        android:background="@drawable/widget_button_background" />

    <!-- Status text (duration when recording) -->
    <Chronometer
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_status_idle"
        android:textSize="10sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginTop="4dp" />

</LinearLayout>
