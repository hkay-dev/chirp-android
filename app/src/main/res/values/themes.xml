<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Chirp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- LOAD-6: a branded window background so the OS-painted starting window (before the first
             Compose frame) reads as Chirp rather than a flat default Material surface. -->
        <item name="android:windowBackground">@drawable/window_background</item>
    </style>

    <!-- LOAD-6: AndroidX core-splashscreen starting theme. Installed in MainActivity.onCreate so a
         cold launch shows the real app icon (the launcher PNG) on the brand surface, then hands
         off to the app via postSplashScreenTheme (Theme.Chirp). -->
    <style name="Theme.Chirp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chirp_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/chirp_splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Chirp</item>
    </style>

    <!-- A RECOGNIZE_SPEECH result surface, not a replacement editor. The floating translucent
         window shape follows Android's built-in voice-input activity and avoids promoting this
         short-lived sheet into a full-screen application window over the caller's IME target. -->
    <style name="Theme.Chirp.VoiceInput" parent="@android:style/Theme">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
