<!-- Keep this list minimal: only directories that are actually shared via
     FileProvider.getUriForFile (audio shares from Home and Studio). In particular,
     do NOT map the cache root - cacheDir holds keyboard dictation WAV staging
     (raw captured speech), which must never be addressable through the provider. -->
<paths>
    <!-- Internal app storage for recordings -->
    <files-path
        name="recordings"
        path="recordings/" />
</paths>
