<?xml version="1.0" encoding="utf-8"?>
<!-- settingsActivity points at the KeyboardSettingsLauncherActivity alias so the gear in
     system keyboard settings deep-links to Chirp's keyboard preferences, not Home (LIF-15). -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="dev.chirpboard.app.KeyboardSettingsLauncherActivity">
    <subtype
        android:imeSubtypeMode="keyboard"
        android:isAuxiliary="false"
        android:label="@string/subtype_label"
        android:imeSubtypeLocale="en_US" />
    <!-- RELY-5: auxiliary voice subtype — invisible in the language switcher, but offered by
         the platform's IME-switching APIs so compliant third-party keyboards can hand their
         mic key to Chirp and get control back after the dictation commits. -->
    <subtype
        android:imeSubtypeMode="voice"
        android:isAuxiliary="true"
        android:overridesImplicitlyEnabledSubtype="false"
        android:label="@string/subtype_voice_label"
        android:imeSubtypeLocale="en_US" />
</input-method>
