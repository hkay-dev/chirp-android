<?xml version="1.0" encoding="utf-8"?>
<!--
  PLT-05: proper adaptive launcher icon. On Android 16 every launcher masks icons into
  adaptive shapes; the legacy PNGs (kept in mipmap-*dpi as a tooling fallback) were being
  letterboxed onto a generated backdrop. The monochrome layer enables Android 13+ themed
  (Material You) icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
