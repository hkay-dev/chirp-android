<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Persistent model storage that survives Clear Data -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".ChirpApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chirp">

        <!-- Main Activity for setup/permissions.
             LIF-16 (documented decision): the ACTION_SEND filter means sharing audio into
             Chirpboard opens a second MainActivity instance inside the sharing app's task.
             That is standard Android share behavior and deliberately kept — singleTask/
             documentLaunchMode would rip the user out of the sharing app's context, and all
             recording/playback state lives in process singletons so dual instances are safe. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Chirp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Static launcher shortcuts (long-press the app icon). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The system keyboard-settings gear (input_method.xml settingsActivity) launches this
             alias; MainActivity detects the alias component and deep-links straight to the
             keyboard settings destination instead of dumping the user on Home (LIF-15). -->
        <activity-alias
            android:name=".KeyboardSettingsLauncherActivity"
            android:targetActivity=".MainActivity"
            android:exported="true" />

        <!-- Voice Recognition Activity for RECOGNIZE_SPEECH intents.
             configChanges keeps rotation/theme changes from recreating the activity
             mid-recognition; smallestScreenSize and density cover foldable posture
             changes, which deliver those alongside screenSize/screenLayout. Standard
             launch mode (no taskAffinity override) keeps this dialog-style activity in
             the caller's task so results are delivered back. -->
        <activity
            android:name=".VoiceRecognitionActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Input Method Service (from feature-keyboard). No foregroundServiceType: the IME
             never calls startForeground — keyboard capture is in-process and recordings run
             through RecordingService, which owns the microphone FGS type. -->
        <service
            android:name="dev.chirpboard.app.feature.keyboard.service.ChirpKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <!-- Recognition Service for Voice Input in Other Apps -->
        <service
            android:name=".ChirpRecognitionService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech.recognition"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- RecordingService is declared by feature-recording's own manifest (single owner);
             a duplicate node here would have to stay attribute-identical forever to keep the
             manifest merger happy, so it was removed. -->

        <!-- Shared recording playback -->
        <service
            android:name="dev.chirpboard.app.core.playback.RecordingPlaybackService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- WorkManager foreground worker (TranscriptionWorker setForeground) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Home Screen Widget -->
        <receiver
            android:name="dev.chirpboard.app.feature.widget.RecordingWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Widget Toggle Receiver -->
        <receiver
            android:name="dev.chirpboard.app.feature.widget.WidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.chirpboard.app.TOGGLE_RECORDING" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing audio files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <!-- Disable default WorkManager initialization so Hilt can inject workers -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
